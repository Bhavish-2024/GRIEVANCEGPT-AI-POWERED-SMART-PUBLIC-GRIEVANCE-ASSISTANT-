# GrievanceGPT Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=30

# Optional Remote / Cloud Inference (for Render or Cloud deployment)
# If Ollama is not accessible, the system will seamlessly use intelligent rule/ML fallback
# REMOTE_LLM_URL=https://api-inference.huggingface.co/models/...
# HF_TOKEN=hf_...

# Database
DATABASE_URL=sqlite:///data/grievance_gpt.db
